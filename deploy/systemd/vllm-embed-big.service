# systemd unit for the vLLM embedding server used for big chunks (Qwen/Qwen3-Embedding-8B).
#
# Install (vLLM in a virtualenv, e.g. python3 -m venv ~/vllm-venv && ~/vllm-venv/bin/pip install vllm):
#   sudo cp deploy/systemd/vllm-embed-big.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vllm-embed-big
# Logs:
#   journalctl -u vllm-embed-big -f
#
# Both embedding servers share one GPU: the --gpu-memory-utilization values of
# vllm-embed-big and vllm-embed-micro must add up to less than 1.0. Older vLLM
# versions use --task embed instead of --runner pooling.

[Unit]
Description=vLLM embedding server (big chunks, Qwen/Qwen3-Embedding-8B)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=piribauer
WorkingDirectory=/home/piribauer
ExecStart=/home/piribauer/vllm-venv/bin/vllm serve Qwen/Qwen3-Embedding-8B \
    --runner pooling \
    --served-model-name qwen3-embedding-8b \
    --host 127.0.0.1 --port 8001 \
    --gpu-memory-utilization 0.60 \
    --max-model-len 8192
# Only count as started once the model is loaded and /health answers, so the
# feeder starts against a ready server. Give up at once if vLLM has exited.
ExecStartPost=/bin/sh -c 'until curl -sf -o /dev/null http://127.0.0.1:8001/health; do kill -0 "$$MAINPID" 2>/dev/null || exit 1; sleep 2; done'
# Downloading and loading the model can take a while on first start.
TimeoutStartSec=900
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
